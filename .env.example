# ============================================
# CONFIGURATION ENVIRONNEMENT - DELIVERY OPTIMIZER
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================

# Profil Spring Boot actif (dev, qa, prod)
ACTIVE_PROFILE=dev

# =====================
# BASE DE DONNÉES - DEV (H2)
# =====================
DB_URL=jdbc:h2:mem:nom-db;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
DB_DRIVER=org.h2.Driver
DB_USER=user_name
DB_PASS=your_secure_password_here

# =====================
# BASE DE DONNÉES - QA (PostgreSQL)
# =====================
# DB_URL=jdbc:postgresql://localhost:5432/nom-db
# DB_DRIVER=org.postgresql.Driver
# DB_USER=nom-user
# DB_PASS=your_secure_password_here

# =====================
# INTELLIGENCE ARTIFICIELLE
# =====================
AI_URL=http://localhost:11434
AI_MODEL=tinyllama
OPTIMIZER_TYPE=ai

# =====================
# SERVEUR
# =====================
SERVER_PORT=8080

# =====================
# NOTES DE CONFIGURATION
# =====================
# 1. Pour PostgreSQL : 
#    - Installer PostgreSQL
#    - Créer la base : CREATE DATABASE delivery_optimizer_qa;
#    - Créer l'utilisateur : CREATE USER delivery_user WITH PASSWORD 'password';
#
# 2. Pour Ollama (IA) :
#    - Installer Ollama : https://ollama.ai/
#    - Télécharger le modèle : ollama pull tinyllama
#
# 3. Variables non définies utilisent les valeurs par défaut de application.yml